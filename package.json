{
  "name": "naomi-gregory-salon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-route-html.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:seo": "node scripts/validate-seo.mjs",
    "test:site:browser": "playwright test tests/e2e/non-contact-site.spec.js",
    "test:site": "npm run lint && npm run build && npm run test:seo && npm run test:site:browser",
    "images:standardize": "node scripts/standardize-images.mjs",
    "images:contact-sheets": "node scripts/create-contact-sheets.mjs",
    "images:validate": "node scripts/validate-images.mjs",
    "favicon:create": "node scripts/create-favicon.mjs"
